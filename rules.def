Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%files
    # Copy the entire project directory from local machine
    ./ /opt/hunyuan3d/

%environment
    export LC_ALL=C
    export PYTHONPATH="/opt/hunyuan3d:$PYTHONPATH"
    export CUDA_HOME=/usr/local/cuda
    export PATH=$CUDA_HOME/bin:$PATH
    export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

%post
    # Update and install dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        git \
        wget \
        curl \
        ca-certificates \
        build-essential \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        ninja-build \
        python3-dev \
        python3-pip \
        && rm -rf /var/lib/apt/lists/*

    # Install PyTorch with CUDA 12.1 directly via pip
    pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

    # Install pip packages
    cd /opt/hunyuan3d
    pip3 install -r requirements.txt

    # Create a startup script that will handle the cache directory
    cat > /opt/hunyuan3d/run_hunyuan3d.sh << 'EOF'
#!/bin/bash
set -e

# Create cache and output directories in user's home
CACHE_DIR="${HOME}/.hunyuan3d_cache"
OUTPUT_DIR="${HOME}/hunyuan3d_outputs"

mkdir -p "${CACHE_DIR}"
mkdir -p "${OUTPUT_DIR}"

echo "Using HuggingFace cache at: ${CACHE_DIR}"
echo "Output directory: ${OUTPUT_DIR}"

# Environment variables for the Python process
export HF_HOME="${CACHE_DIR}"

# Run the Python script with proper environment
cd /opt/hunyuan3d
python3 -c "
import os
os.environ['HF_HOME'] = '${CACHE_DIR}'
print(f'HF_HOME set to {os.environ[\"HF_HOME\"]}')

from hy3dgen.shapegen import Hunyuan3DDiTFlowMatchingPipeline

# Load only the shape generation pipeline
pipeline = Hunyuan3DDiTFlowMatchingPipeline.from_pretrained('tencent/Hunyuan3D-2')

# Generate a mesh without texture
mesh = pipeline(image='assets/demo.png')[0]

# Save the mesh to user's home directory
output_path = '${OUTPUT_DIR}/output.glb'
mesh.export(output_path)
print(f'Mesh saved to {output_path}')
"

echo "Done! Check ${OUTPUT_DIR} for your output files."
EOF

    # Make the script executable
    chmod +x /opt/hunyuan3d/run_hunyuan3d.sh

%runscript
    exec /opt/hunyuan3d/run_hunyuan3d.sh "$@"

%labels
    Author Osmani Dion
    Version v1.0
    Description Hunyuan3D 2.0 container for high-resolution textured 3D asset generation

%help
    This container provides the Hunyuan3D 2.0 environment for generating high-resolution textured 3D assets.

    Usage:

    1. Run the container:
       $ apptainer run --nv hunyuan3d.sif

    The container will create:
    - Cache directory in $HOME/.hunyuan3d_cache
    - Output directory in $HOME/hunyuan3d_outputs
