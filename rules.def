Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%files
# Copy the entire project directory from local machine
./ /opt/hunyuan3d/

    # Include static duck OBJ file
    rubber_duck.obj /opt/hunyuan3d/static_model/model.obj

    # Ensure the patched scripts are included
    hunyuan3d_patched.py /opt/hunyuan3d/hunyuan3d_patched.py

%environment
export LC_ALL=C
export PYTHONPATH="/opt/hunyuan3d:$PYTHONPATH"
export CUDA_HOME=/usr/local/cuda
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

%post
# Update and install dependencies
apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    curl \
    ca-certificates \
    build-essential \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    ninja-build \
    python3-dev \
    python3-pip \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

    # Update libstdc++ for newer GLIBCXX versions
    add-apt-repository -y ppa:ubuntu-toolchain-r/test
    apt-get update && apt-get install -y --no-install-recommends \
        libstdc++6 \
        gcc-11 \
        g++-11 \
        && rm -rf /var/lib/apt/lists/*

    # Verify the updated GLIBCXX versions
    strings /usr/lib/x86_64-linux-gnu/libstdc++.so.6 | grep GLIBCXX

    # Install PyTorch with CUDA 12.1 directly via pip
    pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

    # Upgrade key packages
    pip3 install --upgrade pip setuptools wheel
    pip3 install --upgrade huggingface_hub transformers diffusers

    # Install pip packages
    cd /opt/hunyuan3d
    pip3 install -r requirements.txt

    # Install texture generation requirements directly
    pip3 install onnx onnxruntime-gpu rembg trimesh

    # Make the scripts executable
    chmod +x /opt/hunyuan3d/hunyuan3d_patched.py

    # Create static model directory if it doesn't exist
    mkdir -p /opt/hunyuan3d/static_model

    # Install texture requirements
    cd /opt/hunyuan3d/hy3dgen/texgen/custom_rasterizer
    python3 setup.py install

    cd /opt/hunyuan3d/hy3dgen/texgen/differentiable_renderer
    python3 setup.py install

    # Create output directories
    mkdir -p /tmp/outputs
    mkdir -p /tmp/hunyuan3d_cache

    # Create a directory for the U2Net model (used by rembg)
    mkdir -p /opt/.u2net
    chmod -R 777 /opt/.u2net

%runscript
# Ensure the HOME directory has the cache and output directories
mkdir -p $HOME/.hunyuan3d_cache
mkdir -p $HOME/hunyuan3d_outputs
mkdir -p $HOME/.u2net

    exec /opt/hunyuan3d/hunyuan3d_patched.py "$@"

%labels
Author Osmani Dion
Version v1.0
Description Hunyuan3D 2.0 container for high-resolution textured 3D asset generation

%help
This container provides the Hunyuan3D 2.0 environment for generating high-resolution textured 3D assets.

    Usage:

    1. Generate 3D from image:
    $ apptainer run --nv image.sif image-to-3d --image /path/to/your/image.jpg

    2. Generate 3D using fast model:
    $ apptainer run --nv image.sif fast --image /path/to/your/image.jpg

    3. Generate 3D from text prompt:
    $ apptainer run --nv image.sif text-to-3d --prompt "a red sports car"

    4. Texture an existing model:
    $ apptainer run --nv image.sif texture --obj /path/to/model.obj --prompt "marble texture"

    The container will create:
    - Cache directory in $HOME/.hunyuan3d_cache
    - Output directory in $HOME/hunyuan3d_outputs
